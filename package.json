{
  "name": "@snieuwen/exec-dashboard",
  "version": "0.3.0",
  "description": "Customer-neutral, offline executive estate dashboard core",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "exec-dashboard": "scripts/build.cjs"
  },
  "files": [
    "src",
    "scripts/build.cjs",
    "scripts/build-atlas.cjs",
    "schemas",
    "config/default.json",
    "vendor",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "check:privacy": "node scripts/check-repository.cjs",
    "check": "npm test && npm run check:privacy && npm run build"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
